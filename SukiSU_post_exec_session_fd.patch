--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -36,6 +36,36 @@
 
     fd_install(fd, filp);
     pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
+    return fd;
+}
+
+/*
+ * The userspace ksucalls.rs scans for this exact anon-inode name and prefers
+ * it over [ksu_driver] for a su session. This branch's ioctl dispatcher does
+ * not carry a separate per-FD permission context, so use the same fops while
+ * preserving the session-specific FD identity.
+ */
+int ksu_install_su_fd(void)
+{
+    struct file *filp;
+    int fd;
+
+    fd = get_unused_fd_flags(O_CLOEXEC);
+    if (fd < 0) {
+        pr_err("ksu_install_su_fd: failed to get unused fd\n");
+        return fd;
+    }
+
+    filp = anon_inode_getfile("[ksu_driver_su]", &anon_ksu_fops, NULL,
+                              O_RDWR | O_CLOEXEC);
+    if (IS_ERR(filp)) {
+        pr_err("ksu_install_su_fd: failed to create anon inode file\n");
+        put_unused_fd(fd);
+        return PTR_ERR(filp);
+    }
+
+    fd_install(fd, filp);
+    pr_info("ksu su-session fd installed: %d for pid %d\n", fd, current->pid);
     return fd;
 }
 
