--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -50,6 +50,7 @@
 
 #ifdef CONFIG_KSU_SUSFS
 extern const char __user *get_user_arg_ptr(struct user_arg_ptr argv, int nr);
+extern int ksu_install_su_fd(void);
 /*
  * return 0 -> No further checks should be required afterwards
  * return non-zero -> Further checks should be continued afterwards
@@ -127,6 +128,9 @@
     if (!ksu_handle_execveat_init(filename, (struct user_arg_ptr*)argv_user, (struct user_arg_ptr*)envp_user))
         return 0;
 
+    if (!ksu_su_compat_enabled)
+        return 0;
+
     if (!(__ksu_is_allow_uid_for_current(current_uid().val)))
         return 0;
 
@@ -156,6 +160,36 @@
     }
 
     ksu_sulog_emit_pending(pending_sucompat, ret, GFP_KERNEL);
+
+    /* fs/exec.c installs the su-session FD only for this positive result. */
+    return ret ? 0 : 1;
+}
+
+/*
+ * Install the special driver FD only after the su -> ksud exec succeeded.
+ * The caller invokes this only when the pre-exec hook positively identified
+ * an allowed su session. Do not dereference filename here: the Linux 5.4
+ * exec helper may already have released it when returning to this hook.
+ */
+int ksu_handle_post_execveat_sucompat(int *fd, struct filename **filename_ptr,
+                  void *argv_user, void *envp_user,
+                  int *__never_use_flags, int *retval)
+{
+    int su_fd;
+
+    (void)fd;
+    (void)filename_ptr;
+    (void)argv_user;
+    (void)envp_user;
+    (void)__never_use_flags;
+
+    if (!retval || *retval < 0)
+        return 0;
+
+    su_fd = ksu_install_su_fd();
+    if (su_fd < 0)
+        pr_warn("ksu: failed to install su-session fd: %d\n", su_fd);
+
     return 0;
 }
 
